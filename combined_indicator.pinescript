//@version=6
indicator("RSI + RS + OBV + VStop + 52W + Vol", shorttitle="All-in-One v1.0", overlay=false, max_polylines_count=100, max_bars_back=500)

// ═══════════════════════════════════════════════════════════════════════════════
// PANE SECTION TOGGLES (RSI / RS / OBV — layout reflows automatically)
// ═══════════════════════════════════════════════════════════════════════════════
showRsi = input.bool(true, "Show RSI section", group="Layout")
showRs  = input.bool(true, "Show RS section", group="Layout")
showObv = input.bool(false, "Show OBV section", group="Layout")

// ═══════════════════════════════════════════════════════════════════════════════
// OVERLAY TOGGLES (VStop / 52W / Volume — forced onto main price chart)
// ═══════════════════════════════════════════════════════════════════════════════

// ───── VStop Settings ─────
showVStop   = input.bool(true, "Show Volatility Stop", group="Overlay — VStop")
vstopLen    = input.int(20, "VStop ATR Length", minval=1, group="Overlay — VStop")
vstopMult   = input.float(2.0, "VStop Multiplier", minval=0.1, step=0.1, group="Overlay — VStop")
showSignals = input.bool(true, "Show Trend Flip Signals", group="Overlay — VStop")

// ───── 52-Week High/Low Settings ─────
show52W  = input.bool(true, "Show 52-Week High/Low Lines", group="Overlay — 52W High/Low")
res52W   = input.timeframe("W", "Timeframe for 52W", group="Overlay — 52W High/Low")
len52W   = input.int(52, "Number of Weeks", minval=1, group="Overlay — 52W High/Low")

// ───── Volume Overlay Settings ─────
showVol     = input.bool(true, "Show Volume & MA Overlay", group="Overlay — Volume")
volMaLen    = input.int(13, "Volume MA Length", minval=1, group="Overlay — Volume")
volHeight   = input.float(0.20, "Volume Height % of Chart (0.10–0.40)", minval=0.05, maxval=0.50, step=0.05, group="Overlay — Volume")
volWindow   = input.int(150, "Lookback for Volume Scaling", minval=20, group="Overlay — Volume")

// ═══════════════════════════════════════════════════════════════════════════════
// RSI (in pane)
// ═══════════════════════════════════════════════════════════════════════════════
rsiLen = input.int(14, "RSI Length", minval=1, group="RSI")
rsi    = ta.rsi(close, rsiLen)

// ═══════════════════════════════════════════════════════════════════════════════
// RELATIVE STRENGTH (in pane)
// ═══════════════════════════════════════════════════════════════════════════════
rsMode   = input.string("Rolling lookback", "RS Mode",
     options=["Rolling lookback", "Fixed reference date", "Mansfield (ratio vs its MA)"], group="Relative Strength")
rsLenD   = input.int(63, "Lookback — Daily & intraday (bars)", minval=1, group="Relative Strength",
     tooltip="Used when the chart is on a daily or intraday timeframe. 63 daily bars ≈ one quarter.")
rsLenW   = input.int(52, "Lookback — Weekly (bars)", minval=1, group="Relative Strength",
     tooltip="Used on weekly charts. 52 weeks = one year (Weinstein convention).")
rsLenM   = input.int(12, "Lookback — Monthly (bars)", minval=1, group="Relative Strength",
     tooltip="Used on monthly charts. 12 months = one year.")
refDate  = input.time(timestamp("12 Jan 2026"), "Reference Date (Fixed mode)", group="Relative Strength")
rsMaLen  = input.int(10, "RS MA Length", minval=1, group="Relative Strength")
rsMaType = input.string("SMA", "RS MA Type", options=["SMA", "EMA"], group="Relative Strength")
autoComp = input.bool(true, "Auto-detect benchmark", group="Relative Strength")
manComp  = input.symbol("NSE:CNX500", "Manual Comparison Index", group="Relative Strength")

isIndia   = syminfo.prefix == "NSE" or syminfo.prefix == "BSE" or syminfo.currency == "INR"
compSym   = autoComp ? (isIndia ? "NSE:CNX500" : "SP:SPX") : manComp
baseClose = request.security(compSym, timeframe.period, close)
ratio     = close / baseClose

var float refC = na
var float refB = na
if time <= refDate
    refC := close
    refB := baseClose

effRsLen = timeframe.ismonthly ? rsLenM : timeframe.isweekly ? rsLenW : rsLenD

// short benchmark name for labels (e.g. "SP:SPX" → "SPX")
benchParts = str.split(compSym, ":")
benchName  = array.size(benchParts) > 1 ? array.get(benchParts, 1) : compSym

rollRs  = ratio / ratio[effRsLen] - 1
fixedRs = (close / refC) / (baseClose / refB) - 1
mansRs  = ratio / ta.sma(ratio, effRsLen) - 1
rsRaw   = rsMode == "Fixed reference date" ? fixedRs : rsMode == "Mansfield (ratio vs its MA)" ? mansRs : rollRs
rsMa    = rsMaType == "EMA" ? ta.ema(rsRaw, rsMaLen) : ta.sma(rsRaw, rsMaLen)

// ═══════════════════════════════════════════════════════════════════════════════
// OBV (in pane)
// ═══════════════════════════════════════════════════════════════════════════════
obv = ta.obv

// ═══════════════════════════════════════════════════════════════════════════════
// VOLATILITY STOP (VSTOP) — calculations
// ═══════════════════════════════════════════════════════════════════════════════
vsAtr    = ta.atr(vstopLen)
vsMaxH   = ta.highest(high, vstopLen)
vsMinL   = ta.lowest(low, vstopLen)

var float vsStop = na
var int vsTrend  = 1    // 1 = Bullish, -1 = Bearish

if bar_index == 0
    vsTrend := 1
    vsStop  := vsMaxH - (vstopMult * vsAtr)
else
    if vsTrend == 1
        vsCand = vsMaxH - (vstopMult * vsAtr)
        vsStop := math.max(vsStop[1], vsCand)
        if close < vsStop
            vsTrend := -1
            vsStop  := vsMinL + (vstopMult * vsAtr)
    else
        vsCand = vsMinL + (vstopMult * vsAtr)
        vsStop := math.min(vsStop[1], vsCand)
        if close > vsStop
            vsTrend := 1
            vsStop  := vsMaxH - (vstopMult * vsAtr)

// ═══════════════════════════════════════════════════════════════════════════════
// 52-WEEK HIGH & LOW — calculations
// ═══════════════════════════════════════════════════════════════════════════════
[high52, low52] = request.security(syminfo.tickerid, res52W, [ta.highest(high, len52W), ta.lowest(low, len52W)])

// ═══════════════════════════════════════════════════════════════════════════════
// VOLUME OVERLAY — calculations
// ═══════════════════════════════════════════════════════════════════════════════
volPriceLow  = ta.lowest(low, volWindow)
volPriceHigh = ta.highest(high, volWindow)
volPriceRng  = math.max(volPriceHigh - volPriceLow, 0.0001)

volMax    = math.max(ta.highest(volume, volWindow), 1)
volMaVal  = ta.sma(volume, volMaLen)

scaledVol   = volPriceLow + (volume / volMax) * (volPriceRng * volHeight)
scaledVolMa = volPriceLow + (volMaVal / volMax) * (volPriceRng * volHeight)

// ═══════════════════════════════════════════════════════════════════════════════
// HISTORY STORES: time-based rolling window
// ═══════════════════════════════════════════════════════════════════════════════
yearsD = input.float(3.0, "Render window — Daily & intraday (years)", minval=0.5, step=0.5, group="Display",
     tooltip="How many recent years of RS/OBV are stored and drawn when the chart is on a daily or intraday timeframe.")
yearsW = input.float(10.0, "Render window — Weekly (years)", minval=0.5, step=0.5, group="Display",
     tooltip="Render window used on weekly charts.")
yearsM = input.float(20.0, "Render window — Monthly (years)", minval=0.5, step=0.5, group="Display",
     tooltip="Render window used on monthly charts.")
yearsWin = timeframe.ismonthly ? yearsM : timeframe.isweekly ? yearsW : yearsD
// ── RS scale: hard cap + scroll-aware autoscale ──
rsCap      = input.float(40.0, "RS ceiling/floor cap (±%)", minval=1, group="Display",
     tooltip="The band edges (+100 / -100) never represent more than this. Values beyond it are pegged flat at the ceiling/floor and no longer stretch the scale. Default 40.")
rsAutoFit  = input.bool(true, "Autoscale RS to visible range", group="Display",
     tooltip="When on, the band tightens to fit the largest RS move in the currently VISIBLE date range (recomputed as you scroll/zoom), never expanding past the cap. When off, the band is locked at ±cap.")
rsMinFloor = input.float(10.0, "RS minimum band (±%)", minval=1, group="Display",
     tooltip="Autoscale won't shrink the band tighter than this, so tiny moves don't produce an over-sensitive scale.")
msWin = math.round(yearsWin * 365.0 * 86400000.0)
var array<float> rsArr  = array.new_float()
var array<int>   rsT    = array.new_int()
var array<float> maArr  = array.new_float()
var array<int>   maT    = array.new_int()
var array<float> obvArr = array.new_float()
var array<int>   obvT   = array.new_int()
var int rsStart  = na
var int maStart  = na
var int obvStart = na
if barstate.isconfirmed
    cutoff = time - msWin
    if not na(rsRaw)
        if na(rsStart)
            rsStart := bar_index
        array.push(rsArr, rsRaw)
        array.push(rsT, time)
        while array.size(rsArr) > 0 and (array.get(rsT, 0) < cutoff or array.size(rsArr) > 20000)
            array.shift(rsArr)
            array.shift(rsT)
            rsStart += 1
    if not na(rsMa)
        if na(maStart)
            maStart := bar_index
        array.push(maArr, rsMa)
        array.push(maT, time)
        while array.size(maArr) > 0 and (array.get(maT, 0) < cutoff or array.size(maArr) > 20000)
            array.shift(maArr)
            array.shift(maT)
            maStart += 1
    if na(obvStart)
        obvStart := bar_index
    array.push(obvArr, obv)
    array.push(obvT, time)
    while array.size(obvArr) > 0 and (array.get(obvT, 0) < cutoff or array.size(obvArr) > 20000)
        array.shift(obvArr)
        array.shift(obvT)
        obvStart += 1

// ═══════════════════════════════════════════════════════════════════════════════
// STACKED LAYOUT MATH
// ═══════════════════════════════════════════════════════════════════════════════
slotRsi = 0
slotRs  = (showRsi ? 1 : 0)
slotObv = (showRsi ? 1 : 0) + (showRs ? 1 : 0)
total   = (showRsi ? 1 : 0) + (showRs ? 1 : 0) + (showObv ? 1 : 0)
offFor(slot) => (total - 1 - slot) * 100
rsiOff = offFor(slotRsi)
rsOff  = offFor(slotRs)
obvOff = offFor(slotObv)

// ═══════════════════════════════════════════════════════════════════════════════
// COLORS
// ═══════════════════════════════════════════════════════════════════════════════
colRsi   = color.new(#9C27B0, 0)
colGreen = color.new(#089981, 0)
colRed   = color.new(#F23645, 0)
colNeut  = color.new(#26A69A, 0)
colMa    = color.new(#FF9800, 0)
colObv   = color.new(#2962FF, 0)

// ═══════════════════════════════════════════════════════════════════════════════
// GLOBAL HELPERS
// ═══════════════════════════════════════════════════════════════════════════════
// maps an RS value into its slot, clamped to [off+2, off+98] so pegged
// values never bleed into the section above/below
mapYs(float v, float mA, int off) =>
    raw = 50.0 + v / mA * 48.0
    off + math.max(2.0, math.min(98.0, raw))

flushSeg(array<polyline> pls, array<chart.point> p, color col) =>
    if array.size(p) > 1 and array.size(pls) < 95
        array.push(pls, polyline.new(p, line_color=col, line_width=2))

// true if timestamp tt falls within the visible bar range [lo, hi] (na bound = open)
inVis(int tt, int lo, int hi) => (na(lo) or tt >= lo) and (na(hi) or tt <= hi)

// ═══════════════════════════════════════════════════════════════════════════════
//                      PANE PLOTS (RSI / RS / OBV)
// ═══════════════════════════════════════════════════════════════════════════════

// ───── RSI section: standard theme with gradient OB/OS fills ─────
pRsiL = plot(showRsi ? rsi + rsiOff : na, "RSI band", color=colRsi, linewidth=2, display=display.pane)
p70 = plot(showRsi ? 70 + rsiOff : na, "RSI 70 anchor", color=color.new(color.gray, 100), display=display.pane)
p30 = plot(showRsi ? 30 + rsiOff : na, "RSI 30 anchor", color=color.new(color.gray, 100), display=display.pane)
fill(p70, p30, color=color.new(#9C27B0, 92), title="RSI 30-70 zone")
obFill = rsi >= 70 ? color.from_gradient(rsi, 70, 90, color.new(#089981, 88), color.new(#089981, 35)) : color(na)
fill(pRsiL, p70, color=obFill, title="RSI overbought fill")
osFill = rsi <= 30 ? color.from_gradient(rsi, 10, 30, color.new(#F23645, 35), color.new(#F23645, 88)) : color(na)
fill(pRsiL, p30, color=osFill, title="RSI oversold fill")
plot(showRsi ? 50 + rsiOff : na, "RSI mid", color=color.new(color.gray, 40), linewidth=1, display=display.pane)

// ───── Band background tints (visual differentiation) ─────
pRsT = plot(showRs ? rsOff + 100.0 : na, "RS top anchor", color=color.new(color.gray, 100), display=display.pane)
pRsB = plot(showRs ? rsOff + 0.0 : na, "RS bottom anchor", color=color.new(color.gray, 100), display=display.pane)
fill(pRsT, pRsB, color=color.new(color.teal, 95), title="RS band tint")
// full-height anchors so every band stays inside the pane's auto-scale
// (polylines/labels don't reliably extend TradingView's scale — plots do)
pRiT = plot(showRsi ? rsiOff + 100.0 : na, "RSI top anchor", color=color.new(color.gray, 100), display=display.pane)
pRiB = plot(showRsi ? rsiOff + 0.0 : na, "RSI bottom anchor", color=color.new(color.gray, 100), display=display.pane)
pObT = plot(showObv ? obvOff + 100.0 : na, "OBV top anchor", color=color.new(color.gray, 100), display=display.pane)
pObB = plot(showObv ? obvOff + 0.0 : na, "OBV bottom anchor", color=color.new(color.gray, 100), display=display.pane)
fill(pObT, pObB, color=color.new(#2962FF, 96), title="OBV band tint")

// ───── Separators ─────
plot(total >= 2 ? 100 : na, "Separator 1", color=color.new(color.silver, 0), linewidth=2, display=display.pane)
plot(total >= 3 ? 200 : na, "Separator 2", color=color.new(color.silver, 0), linewidth=2, display=display.pane)

// ───── TRUE values in status line + data window ─────
plot(rsi, "RSI", color=colRsi, display=display.status_line + display.data_window)
plot(rsRaw * 100, "RS %", color=colGreen, display=display.status_line + display.data_window)
plot(rsMa * 100, "RS MA %", color=colMa, display=display.status_line + display.data_window)
plot(obv, "OBV", color=colObv, display=display.status_line + display.data_window)

// ═══════════════════════════════════════════════════════════════════════════════
//               OVERLAY PLOTS (force_overlay → main price chart)
// ═══════════════════════════════════════════════════════════════════════════════

// ───── VStop plots ─────
vsColor = vsTrend == 1 ? color.rgb(38, 166, 154) : color.rgb(239, 83, 80)
plot(showVStop ? vsStop : na, title="VStop", color=vsColor, linewidth=2, style=plot.style_cross, force_overlay=true)

plotshape(showVStop and showSignals and vsTrend == 1 and vsTrend[1] == -1,
     title="VStop Buy Signal", style=shape.triangleup, location=location.belowbar,
     color=color.green, size=size.small, force_overlay=true)
plotshape(showVStop and showSignals and vsTrend == -1 and vsTrend[1] == 1,
     title="VStop Sell Signal", style=shape.triangledown, location=location.abovebar,
     color=color.red, size=size.small, force_overlay=true)

plot(vsStop, "VStop", color=vsColor, display=display.status_line + display.data_window)

// ───── 52W High/Low plots ─────
plotchar(show52W ? high52 : na, title="52-Week High", char="▲", location=location.absolute, color=color.rgb(33, 150, 243), size=size.tiny, force_overlay=true)
plotchar(show52W ? low52  : na, title="52-Week Low",  char="▼", location=location.absolute, color=color.rgb(255, 152, 0),  size=size.tiny, force_overlay=true)

plot(high52, "52W High", color=color.rgb(33, 150, 243), display=display.status_line + display.data_window)
plot(low52,  "52W Low",  color=color.rgb(255, 152, 0),  display=display.status_line + display.data_window)

// ───── Volume overlay plots ─────
volBarColor = close >= open ? color.new(#26a69a, 60) : color.new(#ef5350, 60)

plotcandle(showVol ? volPriceLow : na, showVol ? scaledVol : na,
     showVol ? volPriceLow : na, showVol ? scaledVol : na,
     title="Volume Bars", color=volBarColor, wickcolor=na, bordercolor=volBarColor,
     force_overlay=true)
plot(showVol ? scaledVolMa : na, title="Volume 13 MA", color=#2962FF, linewidth=2, force_overlay=true)

plot(volume, "Volume", color=color.new(#26a69a, 0), display=display.status_line + display.data_window)

// ═══════════════════════════════════════════════════════════════════════════════
//                     DRAWING OBJECTS (RSI / RS / OBV pane)
// ═══════════════════════════════════════════════════════════════════════════════
var line ln70 = na
var line ln30 = na
var line lnZero = na
var polyline maPl = na
var polyline obvPl = na
var array<polyline> rsPls = array.new<polyline>()
var label lRsi = na
var label lRs  = na
var label lObv = na
var label l70t = na
var label l30t = na
var label lRsHi = na
var label lRsLo = na
var label lObvHi = na
var label lObvLo = na

if barstate.islast
    // ── Labels follow the VISIBLE right edge so they stay on screen while scrolling ──
    // (referencing chart.*_visible_bar_time makes the script re-run on scroll/zoom)
    int lblX = nz(chart.right_visible_bar_time, time)
    // ── RSI dashed 30/70 + level text ──
    line.delete(ln70)
    line.delete(ln30)
    label.delete(l70t)
    label.delete(l30t)
    if showRsi
        ln70 := line.new(bar_index - 1, rsiOff + 70, bar_index, rsiOff + 70, extend=extend.both,
             style=line.style_dashed, color=color.new(color.gray, 30))
        ln30 := line.new(bar_index - 1, rsiOff + 30, bar_index, rsiOff + 30, extend=extend.both,
             style=line.style_dashed, color=color.new(color.gray, 30))
        l70t := label.new(lblX, rsiOff + 70, "70", xloc=xloc.bar_time, style=label.style_label_right,
             textcolor=color.new(color.gray, 30), color=color.new(color.gray, 100), size=size.small)
        l30t := label.new(lblX, rsiOff + 30, "30", xloc=xloc.bar_time, style=label.style_label_right,
             textcolor=color.new(color.gray, 30), color=color.new(color.gray, 100), size=size.small)
    // ── RS: symmetric scale, recent-first sign coloring ──
    if array.size(rsPls) > 0
        for j = 0 to array.size(rsPls) - 1
            polyline.delete(array.get(rsPls, j))
        array.clear(rsPls)
    polyline.delete(maPl)
    line.delete(lnZero)
    label.delete(lRsHi)
    label.delete(lRsLo)
    if showRs and array.size(rsArr) > 1
        // ── Scroll-aware extreme: scan only bars inside the visible date range ──
        leftT  = chart.left_visible_bar_time
        rightT = chart.right_visible_bar_time
        float vMin = na
        float vMax = na
        for i = 0 to array.size(rsArr) - 1
            if inVis(array.get(rsT, i), leftT, rightT)
                v = array.get(rsArr, i)
                vMin := na(vMin) ? v : math.min(vMin, v)
                vMax := na(vMax) ? v : math.max(vMax, v)
        if array.size(maArr) > 0
            for i = 0 to array.size(maArr) - 1
                if inVis(array.get(maT, i), leftT, rightT)
                    v = array.get(maArr, i)
                    vMin := na(vMin) ? v : math.min(vMin, v)
                    vMax := na(vMax) ? v : math.max(vMax, v)
        // include current bar's live readings if the right edge is in view
        if inVis(time, leftT, rightT)
            vMin := na(vMin) ? rsRaw : math.min(vMin, rsRaw)
            vMax := na(vMax) ? rsRaw : math.max(vMax, rsRaw)
            if not na(rsMa)
                vMin := math.min(vMin, rsMa)
                vMax := math.max(vMax, rsMa)
        // fallback: nothing in range (e.g. scrolled fully off the data) → use whole window
        if na(vMin) or na(vMax)
            vMin := math.min(array.min(rsArr), rsRaw)
            vMax := math.max(array.max(rsArr), rsRaw)
        // ── Cap + autoscale: never exceeds the cap; shrinks to fit when enabled ──
        cap    = rsCap / 100.0
        floorA = math.min(rsMinFloor / 100.0, cap)
        visAbs = math.max(math.abs(vMin), math.abs(vMax))
        maxAbs = rsAutoFit ? math.min(cap, math.max(visAbs, floorA)) : cap
        if maxAbs > 0
            n = array.size(rsArr)
            step = math.max(1, math.ceil(n / 4000))
            // build newest → oldest so recent data always gets green/red segments;
            // if the polyline budget runs out, only the OLDEST remainder merges into teal
            pts = array.new<chart.point>()
            tailMixed = false
            budget = 90
            prevPos = rsRaw >= 0
            array.push(pts, chart.point.from_index(bar_index, mapYs(rsRaw, maxAbs, rsOff)))
            for i = n - 1 to 0 by step
                v = array.get(rsArr, i)
                pos = v >= 0
                pt = chart.point.from_index(rsStart + i, mapYs(v, maxAbs, rsOff))
                if pos != prevPos
                    if array.size(rsPls) < budget
                        array.push(pts, pt)
                        flushSeg(rsPls, pts, prevPos ? colGreen : colRed)
                        pts := array.new<chart.point>()
                    else
                        tailMixed := true
                    prevPos := pos
                array.push(pts, pt)
            flushSeg(rsPls, pts, tailMixed ? colNeut : (prevPos ? colGreen : colRed))
            // MA polyline
            if array.size(maArr) > 1
                mPts = array.new<chart.point>()
                mN = array.size(maArr)
                mStep = math.max(1, math.ceil(mN / 4000))
                for i = 0 to mN - 1 by mStep
                    array.push(mPts, chart.point.from_index(maStart + i, mapYs(array.get(maArr, i), maxAbs, rsOff)))
                if not na(rsMa)
                    array.push(mPts, chart.point.from_index(bar_index, mapYs(rsMa, maxAbs, rsOff)))
                maPl := polyline.new(mPts, line_color=colMa, line_width=1)
            // zero line + edge labels
            lnZero := line.new(bar_index - 1, rsOff + 50, bar_index, rsOff + 50, extend=extend.both,
                 style=line.style_dashed, color=color.new(color.gray, 40))
            // ── Edge labels: show the cap; reveal the real extreme only when pegged past it ──
            capPct = maxAbs * 100
            hiTxt = "+" + str.tostring(capPct, "#") + "%"
            if vMax > maxAbs
                hiTxt := hiTxt + "  ▲ max +" + str.tostring(vMax * 100, "#.0") + "%"
            loTxt = "-" + str.tostring(capPct, "#") + "%"
            if vMin < -maxAbs
                loTxt := loTxt + "  ▼ min " + str.tostring(vMin * 100, "#.0") + "%"
            // ceiling readout goes ABOVE the grey separator (into the section above) so the
            // RS graph stays clean; falls back inside the band when RS is the top section
            hasRoomAbove = rsOff + 100 < total * 100
            hiY = hasRoomAbove ? rsOff + 104 : rsOff + 94
            lRsHi := label.new(lblX, hiY, hiTxt, xloc=xloc.bar_time, style=label.style_label_right,
                 textcolor=chart.fg_color, color=color.new(chart.bg_color, 15), size=size.small)
            lRsLo := label.new(lblX, rsOff + 6, loTxt, xloc=xloc.bar_time, style=label.style_label_right,
                 textcolor=chart.fg_color, color=color.new(chart.bg_color, 15), size=size.small)
    // ── OBV: exact shape ──
    polyline.delete(obvPl)
    label.delete(lObvHi)
    label.delete(lObvLo)
    if showObv and array.size(obvArr) > 1
        mn = math.min(array.min(obvArr), obv)
        mx = math.max(array.max(obvArr), obv)
        rng = mx - mn
        if rng > 0
            nO = array.size(obvArr)
            stepO = math.max(1, math.ceil(nO / 4000))
            oPts = array.new<chart.point>()
            for i = 0 to nO - 1 by stepO
                array.push(oPts, chart.point.from_index(obvStart + i, obvOff + (array.get(obvArr, i) - mn) / rng * 100))
            array.push(oPts, chart.point.from_index(bar_index, obvOff + (obv - mn) / rng * 100))
            obvPl := polyline.new(oPts, line_color=colObv, line_width=2)
            lObvHi := label.new(lblX, obvOff + 94, str.tostring(mx, format.volume), xloc=xloc.bar_time,
                 style=label.style_label_right, textcolor=chart.fg_color, color=color.new(chart.bg_color, 15), size=size.small)
            lObvLo := label.new(lblX, obvOff + 6, str.tostring(mn, format.volume), xloc=xloc.bar_time,
                 style=label.style_label_right, textcolor=chart.fg_color, color=color.new(chart.bg_color, 15), size=size.small)
    // ── Section labels with true readings ──
    label.delete(lRsi)
    label.delete(lRs)
    label.delete(lObv)
    if showRsi
        lRsi := label.new(lblX, rsiOff + 88, "RSI " + str.tostring(rsi, "#.1"), xloc=xloc.bar_time,
             style=label.style_label_right, textcolor=colRsi, color=color.new(color.gray, 100), size=size.normal)
    if showRs
        // RS title also sits above the grey separator (overlapping RSI section is OK)
        // so the RS graph itself stays unobstructed
        rsTitleY = rsOff + 100 < total * 100 ? rsOff + 115 : rsOff + 78
        lRs := label.new(lblX, rsTitleY,
             "RS(" + str.tostring(effRsLen) + " vs " + benchName + ") " + (rsRaw >= 0 ? "+" : "") + str.tostring(rsRaw * 100, "#.1") + "%",
             xloc=xloc.bar_time, style=label.style_label_right, size=size.normal,
             color=color.new(color.gray, 100), textcolor=rsRaw >= 0 ? colGreen : colRed)
    if showObv
        lObv := label.new(lblX, obvOff + 55, "OBV " + str.tostring(obv, format.volume), xloc=xloc.bar_time,
             style=label.style_label_right, textcolor=colObv, color=color.new(color.gray, 100), size=size.normal)

// ═══════════════════════════════════════════════════════════════════════════════
// VALUE TABLE
// ═══════════════════════════════════════════════════════════════════════════════
showTable = input.bool(false, "Show value table", group="Display")
var table t = table.new(position.top_right, 2, 8, border_width=1)
if barstate.islast and showTable
    table.cell(t, 0, 0, "RSI", text_color=color.white, bgcolor=color.new(#9C27B0, 20), text_size=size.small)
    table.cell(t, 1, 0, str.tostring(rsi, "#.1"), text_color=color.white, bgcolor=color.new(#9C27B0, 20), text_size=size.small)
    rsBg = rsRaw >= 0 ? color.new(#089981, 20) : color.new(#F23645, 20)
    table.cell(t, 0, 1, "RS %", text_color=color.white, bgcolor=rsBg, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(rsRaw * 100, "#.1") + "%", text_color=color.white, bgcolor=rsBg, text_size=size.small)
    obvBg = obv >= obv[1] ? color.new(#2962FF, 20) : color.new(color.gray, 20)
    table.cell(t, 0, 2, "OBV", text_color=color.white, bgcolor=obvBg, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(obv, format.volume), text_color=color.white, bgcolor=obvBg, text_size=size.small)
    table.cell(t, 0, 3, "vs", text_color=color.white, bgcolor=color.new(color.gray, 40), text_size=size.small)
    table.cell(t, 1, 3, compSym, text_color=color.white, bgcolor=color.new(color.gray, 40), text_size=size.small)
    // VStop / 52W overlay values
    vsBg = vsTrend == 1 ? color.new(#089981, 20) : color.new(#F23645, 20)
    table.cell(t, 0, 4, "VStop", text_color=color.white, bgcolor=vsBg, text_size=size.small)
    table.cell(t, 1, 4, str.tostring(vsStop, format.mintick) + (vsTrend == 1 ? " ▲" : " ▼"), text_color=color.white, bgcolor=vsBg, text_size=size.small)
    table.cell(t, 0, 5, "52W H", text_color=color.white, bgcolor=color.new(#2196F3, 20), text_size=size.small)
    table.cell(t, 1, 5, str.tostring(high52, format.mintick), text_color=color.white, bgcolor=color.new(#2196F3, 20), text_size=size.small)
    table.cell(t, 0, 6, "52W L", text_color=color.white, bgcolor=color.new(#FF9800, 20), text_size=size.small)
    table.cell(t, 1, 6, str.tostring(low52, format.mintick), text_color=color.white, bgcolor=color.new(#FF9800, 20), text_size=size.small)
    table.cell(t, 0, 7, "Vol", text_color=color.white, bgcolor=color.new(#26a69a, 20), text_size=size.small)
    table.cell(t, 1, 7, str.tostring(volume, format.volume), text_color=color.white, bgcolor=color.new(#26a69a, 20), text_size=size.small)
