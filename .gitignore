discord_config.json
telegram_config.json
auth_config.json
__pycache__/
*.pyc
alert_report_*.csv
.streamlit/secrets.toml
streamlit.log
*.log
.env
.idea/
.DS_Store
.opencode/
# Screenshots dropped in the repo root while reporting a UI issue. Note macOS
# names these with a NARROW NO-BREAK SPACE (U+202F) before AM/PM, so a shell
# glob typed with an ordinary space silently matches nothing.
Screenshot*.png
# Container-local marker for github_sync.pull_generated_files -- records which
# blob SHAs this container last pulled. Per-container state, never shared.
.data_sync_state.json

# Local-only code reviews (they describe security/privacy details of this
# PUBLIC repo). Kept on disk under docs/, never committed.
docs/CODEBASE_REVIEW_*.md
# Same reason, any naming: the reviews are written under whatever name was
# asked for, and one of them sitting outside this pattern is one `git add -A`
# away from being published.
docs/*review*.md

# Re-runnable verification scripts that accompany the local-only reviews.
docs/review-checks-*/

# Data lives in the private data repo, never in this public code repo. Root
# only: .devcontainer/devcontainer.json and .claude/settings.json are code.
/*.json
# Workflows check the data repo out here (.github/actions/load-data).
data/
# Local-only design notes about what this public repo exposed.
docs/private/
